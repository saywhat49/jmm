<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="5.0" method="upgrade">
    <name>com_jmm</name>
    <author>Saywhat49</author>
    <creationDate>2026-08-31</creationDate>
    <copyright>Copyright (C) 2013-2026 Open Source Matters, Inc. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>saywhat49@gmail.com</authorEmail>
    <authorUrl>https://github.com/saywhat49/jmm</authorUrl>
    <version>5.2.0</version>
    <description>COM_JMM_XML_DESCRIPTION</description>

    <namespace path="src">Saywhat49\Component\Jmm</namespace>

    <scriptfile>script.php</scriptfile>

    <files folder="site">
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages folder="site/language">
        <language tag="en-GB">en-GB/com_jmm.ini</language>
        <language tag="fr-FR">fr-FR/com_jmm.ini</language>
    </languages>

    <administration>
        <menu link="option=com_jmm&amp;view=databases" img="class:database">COM_JMM_MENU_TITLE</menu>
        <submenu>
            <menu link="option=com_jmm&amp;view=databases" alt="COM_JMM_DATABASES" img="class:database">COM_JMM_DATABASES</menu>
            <menu link="option=com_jmm&amp;view=tables" alt="COM_JMM_TABLES" img="class:table">COM_JMM_TABLES</menu>
            <menu link="option=com_jmm&amp;view=sql" alt="COM_JMM_SQL_QUERY" img="class:code">COM_JMM_SQL_QUERY</menu>
            <menu link="option=com_jmm&amp;view=cannedqueries" alt="COM_JMM_CANNED_QUERY" img="class:bookmark">COM_JMM_CANNED_QUERY</menu>
            <menu link="option=com_jmm&amp;view=sitetables" alt="COM_JMM_SITE_TABLES" img="class:globe">COM_JMM_SITE_TABLES</menu>
            <menu link="option=com_jmm&amp;view=createtable" alt="COM_JMM_CREATE_TABLE" img="class:plus">COM_JMM_CREATE_TABLE</menu>
            <menu link="option=com_jmm&amp;view=insert" alt="COM_JMM_INSERT_DATA" img="class:pencil">COM_JMM_INSERT_DATA</menu>
            <menu link="option=com_jmm&amp;view=templates" alt="COM_JMM_TEMPLATES" img="class:color-palette">COM_JMM_TEMPLATES</menu>
        </submenu>

        <files folder="administrator">
            <folder>forms</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <filename>access.xml</filename>
            <filename>config.xml</filename>
        </files>

        <languages folder="administrator/language">
            <language tag="en-GB">en-GB/com_jmm.ini</language>
            <language tag="en-GB">en-GB/com_jmm.sys.ini</language>
            <language tag="fr-FR">fr-FR/com_jmm.ini</language>
            <language tag="fr-FR">fr-FR/com_jmm.sys.ini</language>
        </languages>
    </administration>

    <media destination="com_jmm" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
        <folder>images</folder>
    </media>

    <install>
        <sql>
            <file charset="utf8mb4" driver="mysql">sql/install.mysql.sql</file>
        </sql>
    </install>

    <uninstall>
        <sql>
            <file charset="utf8mb4" driver="mysql">sql/uninstall.mysql.sql</file>
        </sql>
    </uninstall>

    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <updateservers>
        <server type="extension" priority="1" name="JMM Updates">https://raw.githubusercontent.com/saywhat49/jmm/master/update/jmm_update.xml</server>
    </updateservers>
</extension>