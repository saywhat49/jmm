<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout title="COM_JMM_VIEW_TABLE_TITLE" option="COM_JMM_VIEW_TABLE_OPTION">
        <help key="JHELP_MENUS_MENU_ITEM_JMM_TABLE" />
        <message>
            <![CDATA[COM_JMM_VIEW_TABLE_DESC]]>
        </message>
    </layout>
    <fields name="params">
        <fieldset name="basic" label="COM_JMM_SITE_TABLE_CONFIG">
            <field
                name="site_table_id"
                type="sql"
                label="COM_JMM_SELECT_SITE_TABLE"
                description="COM_JMM_SELECT_SITE_TABLE_DESC"
                query="SELECT id AS value, title AS text FROM #__jmm_sitetables WHERE published = 1 ORDER BY title ASC"
                key_field="value"
                value_field="text"
                required="true"
            >
                <option value="">COM_JMM_SELECT_SITE_TABLE</option>
            </field>
            <field
                name="table_pagination"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                default="1"
                label="COM_JMM_ENABLE_PAGINATION"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field
                name="no_record_per_page"
                type="number"
                default="20"
                label="COM_JMM_RECORD_PER_PAGE"
                showon="table_pagination:1"
            />
        </fieldset>
    </fields>
</metadata>