<?xml version="1.0" encoding="utf-8"?>
<metadata>
    <layout title="COM_JMM_VIEW_TABLE_TITLE" option="COM_JMM_VIEW_TABLE_OPTION">
        <help key="JHELP_MENUS_MENU_ITEM_JMM_TABLE" />
        <message>
            <![CDATA[COM_JMM_VIEW_TABLE_DESC]]>
        </message>
    </layout>
    <fields name="params">
        <fieldset name="basic" label="COM_JMM_SITE_TABLE_CONFIG">
            <field
                name="site_table_id"
                type="sql"
                label="COM_JMM_SELECT_SITE_TABLE"
                description="COM_JMM_SELECT_SITE_TABLE_DESC"
                query="SELECT id AS value, title AS text FROM #__jmm_sitetables WHERE published = 1 ORDER BY title ASC"
                key_field="value"
                value_field="text"
                required="true"
            >
                <option value="">COM_JMM_SELECT_SITE_TABLE</option>
            </field>

            <field
                name="jmm_heading"
                type="text"
                label="COM_JMM_HEADING"
                description="COM_JMM_HEADING_DESC"
                size="60"
            />

            <field
                name="show_record_count"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                default="1"
                label="COM_JMM_SHOW_RECORD_COUNT"
                description="COM_JMM_SHOW_RECORD_COUNT_DESC"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="jmm_template_id"
                type="sql"
                label="COM_JMM_SELECT_TEMPLATE"
                description="COM_JMM_SELECT_TEMPLATE_DESC"
                query="SELECT id AS value, title AS text FROM #__jmm_templates WHERE published = 1 ORDER BY title ASC"
                key_field="value"
                value_field="text"
            >
                <option value="">COM_JMM_USE_LAYOUT_BELOW</option>
            </field>

            <field
                name="display_layout"
                type="list"
                label="COM_JMM_DISPLAY_LAYOUT"
                description="COM_JMM_DISPLAY_LAYOUT_DESC"
                default="table"
            >
                <option value="table">COM_JMM_LAYOUT_TABLE</option>
                <option value="cards">COM_JMM_LAYOUT_CARDS</option>
                <option value="chart">COM_JMM_LAYOUT_CHART</option>
                <option value="custom">COM_JMM_LAYOUT_CUSTOM</option>
            </field>

            <field
                name="chart_type"
                type="list"
                label="COM_JMM_CHART_TYPE"
                default="PieChart"
                showon="display_layout:chart"
            >
                <option value="PieChart">COM_JMM_CHART_PIE</option>
                <option value="ColumnChart">COM_JMM_CHART_COLUMN</option>
                <option value="BarChart">COM_JMM_CHART_BAR</option>
            </field>

            <field
                name="table_pagination"
                type="radio"
                layout="joomla.form.field.radio.switcher"
                default="1"
                label="COM_JMM_ENABLE_PAGINATION"
                showon="display_layout!:chart"
            >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>

            <field
                name="no_record_per_page"
                type="number"
                default="25"
                label="COM_JMM_RECORD_PER_PAGE"
                showon="table_pagination:1[AND]display_layout!:chart"
            />
        </fieldset>
    </fields>
</metadata>