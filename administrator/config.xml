<?xml version="1.0" encoding="utf-8"?>
<config>
    <fieldset name="jmm_database_config" label="COM_JMM_CONFIGURATION_DB">
        <field
            name="dbsettings"
            type="radio"
            layout="joomla.form.field.radio.switcher"
            default="0"
            label="COM_JMM_CONFIGURATION_DB_SETTINGS"
        >
            <option value="0">COM_JMM_CONFIGURATION_DB_JOOMLA_SETTINGS</option>
            <option value="1">COM_JMM_CONFIGURATION_DB_CUSTOM_SETTINGS</option>
        </field>
        <field
            name="dbhost"
            type="text"
            label="COM_JMM_CONFIGURATION_DB_HOST"
            default="localhost"
            showon="dbsettings:1"
        />
        <field
            name="dbusername"
            type="text"
            label="COM_JMM_CONFIGURATION_DB_USERNAME"
            default=""
            showon="dbsettings:1"
        />
        <field
            name="dbpass"
            type="password"
            label="COM_JMM_CONFIGURATION_DB_PASSWORD"
            default=""
            showon="dbsettings:1"
        />
        <field
            name="dbname"
            type="text"
            label="COM_JMM_CONFIGURATION_DB_NAME"
            description="COM_JMM_CONFIGURATION_DB_NAME_DESC"
            default=""
            showon="dbsettings:1"
        />
        <field
            name="dbprefix"
            type="text"
            label="COM_JMM_CONFIGURATION_DB_PREFIX"
            description="COM_JMM_CONFIGURATION_DB_PREFIX_DESC"
            default=""
            size="10"
            showon="dbsettings:1"
        />
    </fieldset>

    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
        <field
            name="rules"
            type="rules"
            label="JCONFIG_PERMISSIONS_LABEL"
            filter="rules"
            validate="rules"
            component="com_jmm"
            section="component"
        />
    </fieldset>
</config>