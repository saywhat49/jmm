{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "JMM - simulation (-WhatIf)",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/Deploy-Jmm.ps1",
            "args": ["-Version", "${input:version}", "-WhatIf"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "JMM - publier (tag + workflow)",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}/Deploy-Jmm.ps1",
            "args": ["-Version", "${input:version}"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "JMM - tests PHP",
            "type": "PowerShell",
            "request": "launch",
            "script": "php",
            "args": ["${workspaceFolder}/tests/run.php"],
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
            "id": "version",
            "type": "promptString",
            "description": "Version a publier (X.Y.Z)"
        }
    ]
}
